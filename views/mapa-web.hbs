<style>
/* ── Árbol de sitemap ──────────────────────────────────────────────────── */
.sitemap-tree { font-size: .9rem; }
.st-item      { position: relative; padding: .3rem 0 .3rem 1.2rem; }
.st-children  { padding-left: 1.5rem; border-left: 2px solid var(--bs-border-color); margin-left: .6rem; }

.st-label {
  display: inline-flex;
  align-items: center;
  gap: .45rem;
  flex-wrap: wrap;
}
.st-label code { font-size: .85em; }
.st-desc { color: var(--bs-secondary-color); font-size: .82em; }

.st-label.public  i { color: var(--bs-success); }
.st-label.private i { color: var(--bs-primary); }
.st-label.admin   i { color: var(--bs-danger);  }
.st-label.api     i { color: var(--bs-secondary);}
.st-group-header    { padding-left: 0; list-style: none; }

/* ── Flujos ────────────────────────────────────────────────────────────── */
.flow-list {
  padding-left: 1.2rem;
  margin: 0;
}
.flow-list li {
  padding: .25rem 0;
  font-size: .88rem;
  border-bottom: 1px dashed var(--bs-border-color);
}
.flow-list li:last-child { border-bottom: none; }

/* ── Nodos del modelo de datos ─────────────────────────────────────────── */
.data-node {
  padding: .75rem .5rem;
  border-radius: .5rem;
  border: 1px solid;
  font-size: .85rem;
}

/* ── Tech pills ────────────────────────────────────────────────────────── */
.tech-pill {
  text-align: center;
  padding: .75rem .5rem;
  border: 1px solid var(--bs-border-color);
  border-radius: .5rem;
  font-size: .85rem;
  font-weight: 600;
  background: var(--bs-body-bg);
  height: 100%;
}
.tech-pill i { font-size: 1.4rem; display: block; margin-bottom: .25rem; }
.text-purple { color: #7952b3; }
</style>
