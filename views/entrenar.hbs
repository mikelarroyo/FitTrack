    <span class="text-white-50 small">Música para entrenar</span>
  </div>
  <iframe class="spotify-ok"
          title="Playlist de entrenamiento en Spotify"
          src="https://open.spotify.com/embed/playlist/37i9dQZF1DX76Wlfdnj7AP?utm_source=generator&theme=0"
          width="100%" height="80" frameborder="0"
          allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture"
