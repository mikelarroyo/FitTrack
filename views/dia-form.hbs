<!-- EDITOR DE DÍA DE ENTRENAMIENTO -->
<div class="row justify-content-center">
  <div class="col-12 col-lg-9">

    <div class="d-flex align-items-center gap-3 mb-4 flex-wrap">
      <div>
        <p class="text-muted small mb-0">
          <i class="bi bi-journal-bookmark" aria-hidden="true"></i>
          Plan: <a href="/planes/{{plan.id}}">{{plan.nombre}}</a>
        </p>
        <h1 class="mb-0 icon-text">
          <i class="bi bi-{{#if dia}}pencil{{else}}calendar-plus{{/if}}" aria-hidden="true"></i>
          {{#if dia}}Editar: {{dia.nombre}}{{else}}Nuevo Día{{/if}}
        </h1>
      </div>
    </div>

    <!-- ── Datos del día ───────────────────────────────────────────── -->
    <div class="card shadow-sm mb-4">
      <div class="card-header">
        <h2 class="h5 mb-0 icon-text">
          <i class="bi bi-info-circle" aria-hidden="true"></i>
          Datos del día
        </h2>
      </div>
      <div class="card-body">
        <form action="/planes/{{plan.id}}/dias/{{#if dia}}{{dia.id}}/editar{{else}}nuevo{{/if}}"
              method="POST" novalidate>

          <fieldset class="form-group-related mb-4">
            <legend class="fw-semibold mb-3 small">Identificación</legend>

            <div class="row g-3">
              <div class="col-12 col-sm-8">
                <label for="nombre" class="form-label">
                  Nombre del día <span class="text-danger" aria-hidden="true">*</span>
                </label>
                <input type="text" class="form-control" id="nombre" name="nombre"
                       value="{{#if dia}}{{dia.nombre}}{{/if}}"
                       required aria-required="true"
                       placeholder="Ej: Push, Pull, Legs, Fuerza A, Full Body…">
                <div class="invalid-feedback">El nombre es obligatorio.</div>
              </div>
              <div class="col-12 col-sm-4">
                <label for="dia_semana" class="form-label">Día de la semana</label>
                <select class="form-select" id="dia_semana" name="dia_semana">
                  <option value="">Sin día fijo</option>
                  {{#each diasSemana}}
                  <option value="{{valor}}" {{#if sel}}selected{{/if}}>{{valor}}</option>
                  {{/each}}
                </select>
              </div>
            </div>

            <div class="mt-3">
              <label for="descripcion" class="form-label">Descripción</label>
              <textarea class="form-control" id="descripcion" name="descripcion" rows="2"
                        placeholder="Grupos musculares, objetivo…">{{#if dia}}{{dia.descripcion}}{{/if}}</textarea>
            </div>
          </fieldset>

          <div class="d-flex gap-2">
            <button type="submit" class="btn btn-success icon-text">
              <i class="bi bi-check-lg" aria-hidden="true"></i>
              {{#if dia}}Guardar cambios{{else}}Crear día{{/if}}
            </button>
            <a href="/planes/{{plan.id}}" class="btn btn-outline-secondary icon-text">
              <i class="bi bi-x-lg" aria-hidden="true"></i>
              Cancelar
            </a>
          </div>
        </form>
      </div>
    </div>

    <!-- ── Ejercicios (solo en edición) ───────────────────────────── -->
    {{#if dia}}
    <div class="card shadow-sm mb-4">
      <div class="card-header d-flex justify-content-between align-items-center">
        <h2 class="h5 mb-0 icon-text">
          <i class="bi bi-list-check" aria-hidden="true"></i>
          Ejercicios
        </h2>
        <span class="badge bg-secondary">{{ejercicios.length}} ejercicio(s)</span>
      </div>

      {{#if ejercicios.length}}
      <ul class="list-group list-group-flush" aria-label="Lista de ejercicios">
        {{#each ejercicios}}
        <li class="list-group-item p-0">

          <div class="d-flex justify-content-between align-items-center px-3 py-2">
            <div>
              <strong>{{nombre}}</strong><br>
              <small class="text-muted">
                {{series}} series × {{reps}} reps
                {{#if peso_kg}}&nbsp;·&nbsp;{{peso_kg}} kg{{/if}}
                {{#if hasta_fallo}}<span class="badge badge-fallo ms-1">Fallo</span>{{/if}}
              </small>
            </div>
            <div class="d-flex gap-2">
              <button class="btn btn-sm btn-outline-secondary icon-text"
                      type="button"
                      data-bs-toggle="collapse"
                      data-bs-target="#edit-ej-{{id}}"
                      aria-expanded="false"
                      aria-controls="edit-ej-{{id}}">
                <i class="bi bi-pencil" aria-hidden="true"></i>
                Editar
              </button>
              <form action="/planes/ejercicios/{{id}}/eliminar" method="POST"
                    onsubmit="return confirm('¿Eliminar «{{nombre}}»?')">
                <button type="submit" class="btn btn-sm btn-outline-danger icon-text"
                        aria-label="Eliminar {{nombre}}">
                  <i class="bi bi-trash" aria-hidden="true"></i>
                  Eliminar
                </button>
              </form>
            </div>
          </div>

          <div class="collapse" id="edit-ej-{{id}}">
            <div class="border-top bg-light p-3">
              <form action="/planes/ejercicios/{{id}}/editar" method="POST">
                <div class="mb-2">
                  <label for="edit-nombre-{{id}}" class="form-label form-label-sm fw-semibold">Nombre</label>
                  <input type="text" class="form-control form-control-sm" id="edit-nombre-{{id}}"
                         name="nombre" value="{{nombre}}" required>
                </div>
                <div class="row g-2 mb-2">
                  <div class="col-4">
                    <label for="edit-series-{{id}}" class="form-label form-label-sm fw-semibold">Series</label>
                    <input type="number" class="form-control form-control-sm" id="edit-series-{{id}}"
                           name="series" value="{{series}}" min="1" max="20" required>
                  </div>
                  <div class="col-4">
                    <label for="edit-reps-{{id}}" class="form-label form-label-sm fw-semibold">Reps</label>
                    <input type="number" class="form-control form-control-sm" id="edit-reps-{{id}}"
                           name="reps" value="{{reps}}" min="1" max="100" required>
                  </div>
                  <div class="col-4">
                    <label for="edit-peso-{{id}}" class="form-label form-label-sm fw-semibold">Peso (kg)</label>
                    <input type="number" class="form-control form-control-sm" id="edit-peso-{{id}}"
                           name="peso_kg" value="{{peso_kg}}" step="0.5" min="0" placeholder="Opcional">
                  </div>
                </div>
                <div class="form-check mb-3">
                  <input class="form-check-input" type="checkbox" id="edit-fallo-{{id}}"
                         name="hasta_fallo" value="1" {{#if hasta_fallo}}checked{{/if}}>
                  <label class="form-check-label small" for="edit-fallo-{{id}}">Hasta el fallo muscular</label>
                </div>
                <div class="d-flex gap-2">
                  <button type="submit" class="btn btn-sm btn-success icon-text">
                    <i class="bi bi-check-lg" aria-hidden="true"></i>
                    Guardar
                  </button>
                  <button type="button" class="btn btn-sm btn-outline-secondary"
                          data-bs-toggle="collapse" data-bs-target="#edit-ej-{{id}}">
                    Cancelar
                  </button>
                </div>
              </form>
            </div>
          </div>

        </li>
        {{/each}}
      </ul>
      {{else}}
      <div class="card-body text-muted small fst-italic">
        Añade ejercicios con el formulario de abajo.
      </div>
      {{/if}}

      <!-- Añadir ejercicio -->
      <div class="card-footer">
        <h3 class="h6 mb-3 icon-text">
          <i class="bi bi-plus-circle" aria-hidden="true"></i>
          Añadir ejercicio
        </h3>
        <form action="/planes/{{plan.id}}/dias/{{dia.id}}/ejercicios" method="POST" novalidate>

          <div class="mb-3">
            <label for="ej-nombre" class="form-label">
              Nombre <span class="text-danger" aria-hidden="true">*</span>
            </label>
            <input type="text" class="form-control" id="ej-nombre" name="nombre"
                   required placeholder="Ej: Press banca, Sentadilla, Dominadas…">
            <div class="invalid-feedback">Obligatorio.</div>
          </div>

          <fieldset class="form-group-related mb-3">
            <legend class="small fw-semibold mb-2">
              <i class="bi bi-speedometer2" aria-hidden="true"></i>
              Parámetros de carga
            </legend>
            <div class="row g-2">
              <div class="col-4">
                <label for="ej-series" class="form-label">
                  Series
                  <span data-bs-toggle="tooltip" title="Número de series por ejercicio">
                    <i class="bi bi-question-circle-fill text-primary small" aria-hidden="true"></i>
                  </span>
                </label>
                <input type="number" class="form-control" id="ej-series"
                       name="series" value="3" min="1" max="20" required>
              </div>
              <div class="col-4">
                <label for="ej-reps" class="form-label">
                  Reps
                  <span data-bs-toggle="tooltip" title="Repeticiones objetivo por serie">
                    <i class="bi bi-question-circle-fill text-primary small" aria-hidden="true"></i>
                  </span>
                </label>
                <input type="number" class="form-control" id="ej-reps"
                       name="reps" value="10" min="1" max="100" required>
              </div>
              <div class="col-4">
                <label for="ej-peso" class="form-label">Peso (kg)</label>
                <input type="number" class="form-control" id="ej-peso"
                       name="peso_kg" step="0.5" min="0" placeholder="Opcional">
              </div>
            </div>
            <div class="mt-2">
              <div class="form-check">
                <input class="form-check-input" type="checkbox"
                       id="ej-fallo" name="hasta_fallo" value="1">
                <label class="form-check-label" for="ej-fallo">
                  Hasta el fallo muscular
                  <span data-bs-toggle="tooltip"
                        title="Continuar la serie hasta no poder más con buena técnica">
                    <i class="bi bi-question-circle-fill text-primary small" aria-hidden="true"></i>
                  </span>
                </label>
              </div>
            </div>
          </fieldset>

          <button type="submit" class="btn btn-primary icon-text">
            <i class="bi bi-plus-lg" aria-hidden="true"></i>
            Añadir ejercicio
          </button>
        </form>
      </div>
    </div>

    <!-- Acciones finales -->
    <div class="d-flex gap-2 mb-5">
      <a href="/entrenar/{{dia.id}}" class="btn btn-success icon-text">
        <i class="bi bi-play-circle-fill" aria-hidden="true"></i>
        Entrenar ahora
      </a>
      <a href="/planes/{{plan.id}}" class="btn btn-outline-secondary icon-text">
        <i class="bi bi-arrow-left" aria-hidden="true"></i>
        Volver al plan
      </a>
    </div>
    {{/if}}

  </div>
</div>

<script>
  document.querySelectorAll('[data-bs-toggle="tooltip"]')
    .forEach(el => new bootstrap.Tooltip(el));
</script>
